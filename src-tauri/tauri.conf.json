{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundCheck",
  "version": "0.3.0",
  "identifier": "io.github.weisunglee.soundcheck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoundCheck",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../third_party/lucide-LICENSE.txt": "third_party/lucide-LICENSE.txt"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBQjAzQjdBOTEwMTVERUEKUldUcVhRR1JlanV3Q3VWMXVyNldwbGR3aC9OWEx0MUJ2WFlNMUk1aG9icUVPUDdZM25Pbm9OblYK",
      "endpoints": ["https://github.com/weisunglee/SoundCheck/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "SoundCheck"
}
